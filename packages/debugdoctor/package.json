    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/unit.test.js && node test/smoke-cli.js",
    "lint": "node --check index.js && node --test"
  },
  "keywords": [
    "debug",
    "debugger",
    "console",
    "logging",
    "cli",
    "static-analysis",
    "zero-dependency",
    "ci",
    "code-health"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=14"
  }
}
